{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibetgram.org/v1/registry-provenance.schema.json",
  "title": "VibeTGram addon registry build provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_sequence",
    "source",
    "workflow",
    "review_inputs",
    "generator",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_sequence": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "const": "https://github.com/VibeTGram/addons-market" },
        "commit": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "workflow_path", "workflow_commit", "run_id", "run_attempt", "environment"],
      "properties": {
        "provider": { "const": "github-actions" },
        "repository": { "const": "https://github.com/VibeTGram/addons-market" },
        "workflow_path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$",
          "maxLength": 240
        },
        "workflow_commit": { "$ref": "#/$defs/gitCommit" },
        "run_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "run_attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "environment": { "const": "addons-market-release" }
      }
    },
    "review_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\/$)[A-Za-z0-9._/-]+$",
            "maxLength": 300
          },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "vibetgram-registry" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?$",
      "maxLength": 80
    }
  }
}
