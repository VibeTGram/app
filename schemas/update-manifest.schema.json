{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibetgram.org/v1/update-manifest.schema.json",
  "title": "VibeTGram application update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "application_id",
    "update_key_id",
    "version_name",
    "version_code",
    "artifact",
    "signing_certificate_sha256",
    "bom",
    "tdlib",
    "published_at",
    "expires_at"
  ],
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "stable" } }, "required": ["channel"] },
      "then": { "properties": { "application_id": { "const": "org.vibetgram.client" } } }
    },
    {
      "if": { "properties": { "channel": { "const": "preview" } }, "required": ["channel"] },
      "then": { "properties": { "application_id": { "const": "org.vibetgram.client.preview" } } }
    },
    {
      "if": { "properties": { "channel": { "const": "nightly" } }, "required": ["channel"] },
      "then": { "properties": { "application_id": { "const": "org.vibetgram.client.nightly" } } }
    }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "channel": { "enum": ["stable", "preview", "nightly"] },
    "application_id": {
      "enum": [
        "org.vibetgram.client",
        "org.vibetgram.client.preview",
        "org.vibetgram.client.nightly"
      ]
    },
    "update_key_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "version_name": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?$",
      "maxLength": 80
    },
    "version_code": { "type": "integer", "minimum": 1, "maximum": 2100000000 },
    "minimum_current_version_code": { "type": "integer", "minimum": 1, "maximum": 2100000000 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size_bytes"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/VibeTGram/app/releases/download/",
          "maxLength": 2048
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "signing_certificate_sha256": { "$ref": "#/$defs/sha256" },
    "bom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/VibeTGram/app/releases/download/",
          "maxLength": 2048
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tdlib": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "schema_hash"],
      "properties": {
        "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "schema_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "irreversible_database_migration": { "type": "boolean", "default": false },
    "release_notes_url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
    "published_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
