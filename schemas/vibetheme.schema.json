{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibetgram.org/v1/vibetheme.schema.json",
  "title": "VibeTGram declarative theme manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "id",
    "version",
    "name",
    "description",
    "publisher",
    "gui",
    "resources",
    "licenses"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "type": { "const": "vibetheme" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "minLength": 3,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?$",
      "maxLength": 80
    },
    "name": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id"],
      "properties": {
        "key_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "gui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "$ref": "#/$defs/versionRange" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": { "$ref": "#/$defs/paths" },
        "typography": { "$ref": "#/$defs/paths" },
        "shapes": { "$ref": "#/$defs/paths" },
        "motion": { "$ref": "#/$defs/paths" },
        "icons": { "$ref": "#/$defs/paths" },
        "backgrounds": { "$ref": "#/$defs/paths" },
        "locales": { "$ref": "#/$defs/paths" }
      },
      "minProperties": 1
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "issue_tracker": { "type": "string", "format": "uri", "maxLength": 2048 }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?$",
      "maxLength": 80
    },
    "versionRange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact"],
          "properties": { "exact": { "$ref": "#/$defs/semver" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minimum_inclusive": { "$ref": "#/$defs/semver" },
            "maximum_exclusive": { "$ref": "#/$defs/semver" }
          }
        }
      ]
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "required": ["en"],
      "propertyNames": { "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\/$)[A-Za-z0-9._/-]+$",
      "maxLength": 240
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2048,
      "items": { "$ref": "#/$defs/path" }
    }
  }
}
